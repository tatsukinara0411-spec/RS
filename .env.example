# Google Sheets 設定
GOOGLE_SERVICE_ACCOUNT_JSON=   # サービスアカウントJSONの全文（GitHub Secretsで管理推奨）
GOOGLE_CREDS_PATH=./credentials/service_account.json  # ローカル実行時のパス
GOOGLE_SPREADSHEET_ID=         # 既存スプレッドシートのID（省略時は自動作成）

# 実行設定
DB_PATH=./data/leads.db
LOG_LEVEL=INFO
SCRAPE_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true
